\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Representative FFD-deformed burner geometries used in the comparison. The convergent case contracts the near-root passage, whereas the divergent case opens it, thereby modifying the flow field seen by the anchored flame.\relax }}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:geometry-comparison}{{7}{10}{Representative FFD-deformed burner geometries used in the comparison. The convergent case contracts the near-root passage, whereas the divergent case opens it, thereby modifying the flow field seen by the anchored flame.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Comparison of the reconstructed flame transfer functions for the baseline, convergent, and divergent burner geometries. The convergent lip increases the main gain peak and shifts it toward higher frequency, whereas the divergent lip suppresses the peak and produces a flatter response over the low-to-mid frequency range.\relax }}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:geometry-ftf-comparison}{{8}{10}{Comparison of the reconstructed flame transfer functions for the baseline, convergent, and divergent burner geometries. The convergent lip increases the main gain peak and shifts it toward higher frequency, whereas the divergent lip suppresses the peak and produces a flatter response over the low-to-mid frequency range.\relax }{figure.caption.10}{}}
